{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": [
        "POSTGRES_TEST_URL",
        "POSTGRES_TEST_CONTAINER",
        "POSTGRES_TEST_PORT",
        "POSTGRES_TEST_PASSWORD",
        "POSTGRES_TEST_DB",
        "POSTGRES_TEST_USER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ADMIN_SECRET",
        "CORS_ORIGIN",
        "POSTGRES_URL",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_DB",
        "POSTGRES_SSL",
        "DEFAULT_MODEL",
        "LLM_API_KEY",
        "LLM_BASE_URL",
        "LLM_PROVIDER",
        "LOG_LEVEL",
        "PORT",
        "VOLCANO_EMBEDDING_KEY",
        "VOLCANO_EMBEDDING_MODEL"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
