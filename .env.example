# Database
# SQLite is fine for local development and small single-node trials.
DB_TYPE=sqlite
# DATABASE_URL is still accepted for compatibility, but DB_PATH is preferred for SQLite.
DB_PATH=data/agentforge.db

# MySQL is recommended for private-cloud production deployments.
# DB_TYPE=mysql
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=agentforge
# MYSQL_PASSWORD=change-me-mysql
# MYSQL_DATABASE=agentforge
# MYSQL_URL=mysql://agentforge:change-me-mysql@mysql:3306/agentforge

# LLM Provider
LLM_PROVIDER=claude
LLM_API_KEY=
# LLM_BASE_URL=  # Optional: for OpenAI-compatible providers
# DEFAULT_MODEL=claude-sonnet-4-20250514

# Server
PORT=3000
ADMIN_SECRET=change-me-in-production
ADMIN_EMAIL=demo@example.com
# Local demo password only. Production refuses this value.
ADMIN_PASSWORD=password
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
CORS_ORIGIN=true
# PUBLIC_URL is required for production OIDC / OAuth callback URLs.
# PUBLIC_URL=https://agentforge.example.com
