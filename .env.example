# AgentForge one-command Docker deployment
NODE_ENV=production
PORT=3000

# PostgreSQL is the only supported runtime database.
DB_TYPE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agentforge
# Optional app-side connection pool limits.
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
# Optional alternative to discrete POSTGRES_* settings:
# POSTGRES_URL=postgres://agentforge:change-me-postgres@postgres:5432/agentforge

# Initial LLM model.
LLM_PROVIDER=claude
LLM_API_KEY=change-me-llm-key
LLM_BASE_URL=
DEFAULT_MODEL=claude-sonnet-4-20250514

# Local bootstrap admin and emergency automation secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SECRET=change-me-admin-secret
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=true

# Public deployment origin and browser API policy.
PUBLIC_URL=https://agentforge.example.com
CORS_ORIGIN=https://agentforge.example.com

# Optional knowledge-base embedding provider.
VOLCANO_EMBEDDING_KEY=
VOLCANO_EMBEDDING_MODEL=doubao-embedding-vision-250615
