{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified Agent Service Platform",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @agentforge/server dev",
    "dev:web": "pnpm --filter @agentforge/web dev",
    "preflight:prod": "tsx scripts/preflight-prod.ts",
    "verify:mysql": "tsx scripts/verify-mysql-migrations.ts",
    "backup:mysql": "bash scripts/backup-mysql.sh",
    "restore:mysql": "bash scripts/restore-mysql.sh",
    "start": "node packages/server/dist/index.js",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@agentforge/core": "workspace:*",
    "@agentforge/database": "workspace:*",
    "@agentforge/providers": "workspace:*",
    "@agentforge/server": "workspace:*",
    "@agentforge/skills": "workspace:*",
    "@agentforge/tools": "workspace:*",
    "@agentforge/types": "workspace:*",
    "dotenv": "^17.3.1",
    "mysql2": "^3.20.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "uuid": "^11.0.0",
    "vitest": "^3.0.0"
  }
}
