{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified Agent Service Platform",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @agentforge/server dev",
    "dev:web": "pnpm --filter @agentforge/web dev",
    "preflight:prod": "tsx scripts/preflight-prod.ts",
    "verify:postgres": "tsx scripts/verify-postgres-migrations.ts",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "demo:seed": "tsx scripts/demo-data.ts seed",
    "demo:reset": "tsx scripts/demo-data.ts reset",
    "demo:status": "tsx scripts/demo-data.ts status",
    "verify:commercial": "tsx scripts/verify-commercial-readiness.ts",
    "start": "node packages/server/dist/index.js",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@agentforge/core": "workspace:*",
    "@agentforge/database": "workspace:*",
    "@agentforge/providers": "workspace:*",
    "@agentforge/server": "workspace:*",
    "@agentforge/skills": "workspace:*",
    "@agentforge/tools": "workspace:*",
    "@agentforge/types": "workspace:*",
    "dotenv": "^17.3.1",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "uuid": "^11.0.0",
    "vitest": "^3.0.0"
  }
}
